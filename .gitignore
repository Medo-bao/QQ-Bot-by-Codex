# Publish source files only. Local data and generated assets stay outside Git.
/*
!/.gitignore
!/.npmignore
!/.env.example
!/LICENSE
!/README.md
!/README_EN.md
!/CHANGELOG.md
!/CHANGELOG_EN.md
!/package.json
!/package-lock.json
!/.codex-plugin/
!/.mcp.json
!/tsconfig.json
!/src/
!/scripts/
!/tests/
!/skills/
!/assets/
/assets/*
!/assets/icons/
!/.agents/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# Never include dependencies, build products or local runtime files.
node_modules/
dist/
release/
artifacts/
storage/
session/
sessions/
codex-home/
media/
.dsh-sessions/
.env
.env.*
!.env.example
*.log
*.jsonl
*.tsbuildinfo
